# Copy this file to `.env`.   cp .env.example .env

# Required for LLM mode. Free key: https://console.groq.com/keys
# Not needed if you run with AGENT_MODE=playbook.
GROQ_API_KEY=your_groq_api_key_here

# --- everything below is optional (defaults shown) ---

# llm | playbook   — 'playbook' skips the LLM entirely (offline, deterministic)
# AGENT_MODE=llm

# seed for the outcome model
# RECOVERY_SEED=42

# route the Act stage through the MCP server
# USE_MCP=0

# online learning loop (1 = blend observed rates back into the model)
# LEARNING=1

# dataset for run_batch.py / legacy UI
# DATASET=data/transactions_v2.csv

# actually send recovery emails (email channel only) — all four must be set
# NOTIFY_REAL=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
# NOTIFY_TO=customer@example.com
